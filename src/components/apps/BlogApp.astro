---
import AppWindow from "../os/AppWindow.astro";
import PostCard from "../common/PostCard.astro";
import Badge from "../common/Badge.astro";
import EmptyState from "../common/EmptyState.astro";
import { postCategories, posts, postTags } from "../../data/posts";
import { projects } from "../../data/projects";

const initialPost = posts[0];
const initialProject = projects.find((project) => project.slug === initialPost.relatedProject);
---

<AppWindow title="Blog.app" subtitle="Reader workspace" wide detailControls>
  <div class="blog-workbench" data-blog-workbench data-master-detail data-layout="idle">
    <div class="toolbar toolbar-stacked">
      <label class="search-field">
        <span>Search</span>
        <input type="search" data-post-search-input placeholder="Search title, tag, project, or body" autocomplete="off" />
      </label>

      <div class="filter-stack">
        <div class="filter-group" aria-label="Post category filters">
          <button type="button" class="filter-button is-active" data-post-category-filter="all">All</button>
          {
            postCategories.map((category) => (
              <button type="button" class="filter-button" data-post-category-filter={category}>{category}</button>
            ))
          }
        </div>

        <div class="filter-group" aria-label="Post tag filters">
          <button type="button" class="filter-button is-active" data-post-tag-filter="all">All tags</button>
          {postTags.map((tag) => <button type="button" class="filter-button" data-post-tag-filter={tag}>{tag}</button>)}
        </div>
      </div>
      <button type="button" class="button button-secondary" data-post-clear-filters>Clear Filters</button>
    </div>

    <div class="master-detail blog-reader-layout" data-blog-layout data-layout="idle">
      <section class="master-panel blog-list-panel" data-blog-list-panel aria-label="Article list">
        <div class="post-list" data-post-list>
          {posts.map((post, index) => <PostCard post={post} selected={index === 0} />)}
        </div>
        <EmptyState
          title="No matching files found"
          description="Try another title, tag, project, or clear the current filters."
          data-post-empty
          hidden
        />
      </section>

      <article class="detail-panel reader-panel" data-post-reader aria-live="polite">
        <div class="detail-actions reader-topline">
          <button type="button" class="button button-secondary reader-back" data-reader-back data-md-close>Back to list</button>
          <button type="button" class="button button-secondary" data-md-expand>Expand list</button>
          <span class="meta-pill" data-post-detail-reading>{initialPost.readingTime}</span>
        </div>

        <div class="reader-progress" aria-label="Reading progress">
          <span data-reader-progress></span>
        </div>

        <p class="eyebrow" data-post-detail-category>{initialPost.category}</p>
        <h3 data-post-detail-title>{initialPost.title}</h3>
        <p class="reader-summary" data-post-detail-summary>{initialPost.summary}</p>

        <div class="detail-stack">
          <span>
            Date:
            <strong data-post-detail-date>{initialPost.date}</strong>
          </span>
          <span>
            Related project:
            <strong data-post-detail-project>{initialPost.relatedProjectLabel}</strong>
          </span>
        </div>

        <section class="related-panel">
          <h4>Related Project</h4>
          <div class="related-list" data-post-related-project>
            {
              initialProject ? (
                <button type="button" class="related-link" data-lab-open-project={initialProject.slug}>
                  {initialProject.name}
                  <span>{initialProject.type}</span>
                </button>
              ) : (
                <p class="empty-state">No related project for this article.</p>
              )
            }
          </div>
        </section>

        <div class="badge-row" data-post-detail-tags>
          {initialPost.tags.map((tag) => <Badge label={tag} />)}
        </div>

        <div class="reader-body" data-reader-body tabindex="0">
          {
            initialPost.body.map((block) => (
              <section>
                <h4>{block.heading}</h4>
                {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {
                  block.bullets && (
                    <ul>
                      {block.bullets.map((item) => <li>{item}</li>)}
                    </ul>
                  )
                }
              </section>
            ))
          }
        </div>

        <section class="related-panel">
          <h4>Related Articles</h4>
          <div class="related-list" data-post-related></div>
        </section>

        <section class="roadmap-panel">
          <h4>Roadmap</h4>
          <ul data-post-detail-roadmap>
            {initialPost.roadmap.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </article>
    </div>
  </div>

  <script is:inline type="application/json" id="posts-data" set:html={JSON.stringify(posts)} />
  <script is:inline type="application/json" id="blog-projects-data" set:html={JSON.stringify(projects)} />
</AppWindow>

<script>
  const initBlogApp = () => {
  type PostBodyBlock = {
    heading: string;
    paragraphs: string[];
    bullets?: string[];
  };

  type PostRecord = {
    slug: string;
    title: string;
    summary: string;
    date: string;
    category: string;
    tags: string[];
    relatedProject: string;
    relatedProjectLabel: string;
    readingTime: string;
    body: PostBodyBlock[];
    roadmap: string[];
  };

  type ProjectRecord = {
    slug: string;
    name: string;
    type: string;
  };

  const dataNode = document.getElementById("posts-data");
  const projectDataNode = document.getElementById("blog-projects-data");
  const postData: PostRecord[] = dataNode?.textContent ? JSON.parse(dataNode.textContent) : [];
  const projectData: ProjectRecord[] = projectDataNode?.textContent ? JSON.parse(projectDataNode.textContent) : [];
  const workbench = document.querySelector("[data-blog-workbench]");
  const layout = document.querySelector("[data-blog-layout]");
  const searchInput = document.querySelector("[data-post-search-input]");
  const categoryButtons = Array.from(document.querySelectorAll("[data-post-category-filter]"));
  const tagButtons = Array.from(document.querySelectorAll("[data-post-tag-filter]"));
  const cards = Array.from(document.querySelectorAll("[data-post-card]"));
  const reader = document.querySelector("[data-post-reader]");
  const readerBody = document.querySelector("[data-reader-body]");
  const progress = document.querySelector("[data-reader-progress]");
  const emptyState = document.querySelector("[data-post-empty]");
  if (!(workbench instanceof HTMLElement) || workbench.dataset.controllerReady === "true") return;
  workbench.dataset.controllerReady = "true";
  let activeCategory = "all";
  let activeTag = "all";
  let activeSlug = new URLSearchParams(window.location.search).get("post") || postData[0]?.slug || "";

  const setText = (selector: string, value: string) => {
    const node = reader?.querySelector(selector);
    if (node) node.textContent = value;
  };

  const createBadge = (label: string) => {
    const badge = document.createElement("span");
    badge.className = "badge badge-default";
    badge.textContent = label;
    return badge;
  };

  const renderBody = (post: PostRecord) => {
    if (!readerBody) return;
    readerBody.textContent = "";
    post.body.forEach((block, index) => {
      const section = document.createElement("section");
      section.style.setProperty("--stagger-index", String(index));
      const heading = document.createElement("h4");
      heading.textContent = block.heading;
      section.append(heading);

      block.paragraphs.forEach((paragraph) => {
        const p = document.createElement("p");
        p.textContent = paragraph;
        section.append(p);
      });

      if (block.bullets?.length) {
        const list = document.createElement("ul");
        block.bullets.forEach((item) => {
          const li = document.createElement("li");
          li.textContent = item;
          list.append(li);
        });
        section.append(list);
      }

      readerBody.append(section);
    });
  };

  const getRelatedPosts = (post: PostRecord) => {
    return postData
      .filter((item) => item.slug !== post.slug)
      .map((item) => {
        const sharedTags = item.tags.filter((tag) => post.tags.includes(tag)).length;
        const sameProject = item.relatedProject === post.relatedProject ? 2 : 0;
        return { item, score: sharedTags + sameProject };
      })
      .filter((entry) => entry.score > 0)
      .sort((a, b) => b.score - a.score || b.item.date.localeCompare(a.item.date))
      .slice(0, 3)
      .map((entry) => entry.item);
  };

  const renderRelated = (post: PostRecord) => {
    const wrap = reader?.querySelector("[data-post-related]");
    if (!wrap) return;
    wrap.textContent = "";
    getRelatedPosts(post).forEach((related) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "related-link";
      button.dataset.labOpenPost = related.slug;
      button.textContent = related.title;
      const meta = document.createElement("span");
      meta.textContent = related.category;
      button.append(meta);
      wrap.append(button);
    });
  };

  const renderRelatedProject = (post: PostRecord) => {
    const wrap = reader?.querySelector("[data-post-related-project]");
    if (!wrap) return;
    wrap.textContent = "";
    const project = projectData.find((item) => item.slug === post.relatedProject);
    if (!project) {
      const empty = document.createElement("p");
      empty.className = "empty-state";
      empty.textContent = "No related project for this article.";
      wrap.append(empty);
      return;
    }

    const button = document.createElement("button");
    button.type = "button";
    button.className = "related-link";
    button.dataset.labOpenProject = project.slug;
    button.textContent = project.name;
    const meta = document.createElement("span");
    meta.textContent = project.type;
    button.append(meta);
    wrap.append(button);
  };

  const updateProgress = () => {
    if (!(readerBody instanceof HTMLElement) || !(progress instanceof HTMLElement)) return;
    const max = readerBody.scrollHeight - readerBody.clientHeight;
    const value = max <= 0 ? 100 : Math.min(100, Math.max(0, (readerBody.scrollTop / max) * 100));
    progress.style.width = `${value}%`;
  };

  const openReader = () => {
    if (workbench instanceof HTMLElement) workbench.dataset.layout = "focused";
    if (layout instanceof HTMLElement) layout.dataset.layout = "focused";
    window.labOS?.setState({ layoutState: "focused" });
    requestAnimationFrame(updateProgress);
  };

  const closeReader = () => {
    if (workbench instanceof HTMLElement) workbench.dataset.layout = "idle";
    if (layout instanceof HTMLElement) layout.dataset.layout = "idle";
    window.labOS?.setState({ layoutState: "idle" });
  };

  const toggleExpanded = () => {
    if (!(layout instanceof HTMLElement) || !(workbench instanceof HTMLElement)) return;
    const next = layout.dataset.layout === "expanded" ? "focused" : "expanded";
    layout.dataset.layout = next;
    workbench.dataset.layout = next;
    window.labOS?.setState({ layoutState: next });
    document.querySelectorAll("[data-md-expand]").forEach((node) => {
      if (node instanceof HTMLButtonElement) {
        node.textContent = next === "expanded" ? "Focus detail" : "Expand list";
      }
    });
  };

  const selectPost = (slug: string, shouldOpen = true) => {
    const post = postData.find((item) => item.slug === slug) || postData[0];
    if (!post) return;
    activeSlug = post.slug;
    cards.forEach((card) => card.setAttribute("data-selected", card.getAttribute("data-post-slug") === activeSlug ? "true" : "false"));
    setText("[data-post-detail-category]", post.category);
    setText("[data-post-detail-title]", post.title);
    setText("[data-post-detail-summary]", post.summary);
    setText("[data-post-detail-date]", post.date);
    setText("[data-post-detail-project]", post.relatedProjectLabel);
    setText("[data-post-detail-reading]", post.readingTime);

    const tagWrap = reader?.querySelector("[data-post-detail-tags]");
    if (tagWrap) {
      tagWrap.textContent = "";
      post.tags.forEach((tag) => tagWrap.append(createBadge(tag)));
    }

    renderBody(post);
    renderRelated(post);
    renderRelatedProject(post);

    const roadmap = reader?.querySelector("[data-post-detail-roadmap]");
    if (roadmap) {
      roadmap.textContent = "";
      post.roadmap.forEach((item) => {
        const li = document.createElement("li");
        li.textContent = item;
        roadmap.append(li);
      });
    }

    if (readerBody instanceof HTMLElement) readerBody.scrollTop = 0;
    updateProgress();
    if (shouldOpen) openReader();
  };

  const applyPostFilters = () => {
    const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : "";
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = card.getAttribute("data-post-category") || "";
      const tags = card.getAttribute("data-post-tags") || "";
      const matchesCategory = activeCategory === "all" || category === activeCategory;
      const matchesTag = activeTag === "all" || tags.split("|").includes(activeTag.toLowerCase());
      const matchesSearch = (card.getAttribute("data-post-search") || "").includes(query);
      const visible = matchesCategory && matchesTag && matchesSearch;
      (card as HTMLElement).hidden = !visible;
      if (visible) visibleCount += 1;
    });

    if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;
  };

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.getAttribute("data-post-category-filter") || "all";
      categoryButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyPostFilters();
    });
  });

  tagButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeTag = button.getAttribute("data-post-tag-filter") || "all";
      tagButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyPostFilters();
    });
  });

  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener("input", applyPostFilters);
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const slug = card.getAttribute("data-post-slug") || "";
      selectPost(slug);
      window.labOS?.openPost(slug, { navigate: false });
    });
    card.addEventListener("keydown", (event) => {
      if (event instanceof KeyboardEvent && (event.key === "Enter" || event.key === " ")) {
        event.preventDefault();
        const slug = card.getAttribute("data-post-slug") || "";
        selectPost(slug);
        window.labOS?.openPost(slug, { navigate: false });
      }
    });
  });

  document.addEventListener("labos:post-open", (event) => {
    if (!(event instanceof CustomEvent)) return;
    const slug = event.detail?.postSlug;
    if (typeof slug === "string") selectPost(slug, true);
  });

  const backButton = document.querySelector("[data-reader-back]");
  if (backButton instanceof HTMLButtonElement) {
    backButton.addEventListener("click", closeReader);
  }

  const expandButton = document.querySelector("[data-md-expand]");
  if (expandButton instanceof HTMLButtonElement) {
    expandButton.addEventListener("click", toggleExpanded);
  }

  const clearButton = document.querySelector("[data-post-clear-filters]");
  if (clearButton instanceof HTMLButtonElement) {
    clearButton.addEventListener("click", () => {
      activeCategory = "all";
      activeTag = "all";
      if (searchInput instanceof HTMLInputElement) searchInput.value = "";
      categoryButtons.forEach((item) => item.classList.toggle("is-active", item.getAttribute("data-post-category-filter") === "all"));
      tagButtons.forEach((item) => item.classList.toggle("is-active", item.getAttribute("data-post-tag-filter") === "all"));
      applyPostFilters();
    });
  }

  if (readerBody instanceof HTMLElement) {
    readerBody.addEventListener("scroll", updateProgress);
  }
  window.addEventListener("resize", updateProgress);

  selectPost(activeSlug, new URLSearchParams(window.location.search).has("post"));
  applyPostFilters();
  };

  initBlogApp();
  document.addEventListener("astro:page-load", initBlogApp);
</script>
