---
import AppWindow from "../os/AppWindow.astro";
import ExperienceModeControl from "../os/ExperienceModeControl.astro";
---

<AppWindow title="Settings.app" subtitle="System Settings" wide>
  <div class="settings-grid">
    <section class="setting-panel">
      <div>
        <p class="eyebrow" data-i18n="settings.theme">Theme</p>
        <h3>Display</h3>
      </div>
      <label class="select-field">
        <span data-i18n="settings.theme">Theme</span>
        <select data-setting-theme>
          <option value="light" data-i18n="settings.light">Light</option>
          <option value="dark" data-i18n="settings.dark">Dark</option>
          <option value="system" data-i18n="settings.system">System</option>
        </select>
      </label>
    </section>

    <section class="setting-panel">
      <div>
        <p class="eyebrow" data-i18n="settings.experience">Experience Mode</p>
        <h3>
          Current:
          <span data-current-experience>Balanced</span>
        </h3>
      </div>
      <ExperienceModeControl />
    </section>

    <section class="setting-panel">
      <div>
        <p class="eyebrow" data-i18n="settings.motionSpeed">Motion Speed</p>
        <h3>
          Current:
          <span data-current-motion-speed>Normal</span>
        </h3>
      </div>
      <label class="select-field">
        <span data-i18n="settings.motionSpeed">Motion Speed</span>
        <select data-setting-motion-speed>
          <option value="slow" data-i18n="settings.slow">Slow</option>
          <option value="normal" data-i18n="settings.normal">Normal</option>
          <option value="fast" data-i18n="settings.fast">Fast</option>
        </select>
      </label>
      <div class="mode-notes">
        <p>
          <strong>Speed Profile</strong>
          <span>Performance mode automatically keeps motion minimal even when a slower display speed is selected.</span>
        </p>
      </div>
    </section>

    <section class="setting-panel">
      <div>
        <p class="eyebrow" data-i18n="settings.language">Language</p>
        <h3>Interface Copy</h3>
      </div>
      <label class="select-field">
        <span data-i18n="settings.language">Language</span>
        <select data-setting-language>
          <option value="en">English</option>
          <option value="zh">&#20013;&#25991;</option>
        </select>
      </label>
    </section>

    <section class="setting-panel">
      <div>
        <p class="eyebrow" data-i18n="settings.storage">Saved to localStorage</p>
        <h3>Local Settings</h3>
      </div>
      <p data-labos-status>System State preferences are synced to html/body data attributes.</p>
      <button type="button" class="button button-danger" data-reset-settings data-i18n="settings.reset">
        Reset local settings
      </button>
    </section>

    <section class="setting-panel">
      <div>
        <p class="eyebrow" data-i18n="settings.recent">Recent Items</p>
        <h3>Recently Opened</h3>
      </div>
      <div class="compact-list recent-list" data-recent-items-list></div>
      <button type="button" class="button button-secondary" data-clear-recent-items data-i18n="settings.clearRecent">
        Clear recent items
      </button>
    </section>

    <section class="setting-panel">
      <div>
        <p class="eyebrow" data-i18n="settings.shortcuts">Keyboard Shortcuts</p>
        <h3>Command Controls</h3>
      </div>
      <dl class="shortcut-list">
        <div>
          <dt><kbd>Ctrl</kbd>/<kbd>Cmd</kbd> + <kbd>K</kbd></dt>
          <dd>Open Command Palette</dd>
        </div>
        <div>
          <dt><kbd>Esc</kbd></dt>
          <dd>Close panel</dd>
        </div>
        <div>
          <dt><kbd>Enter</kbd></dt>
          <dd>Execute command</dd>
        </div>
        <div>
          <dt><kbd>ArrowUp</kbd> / <kbd>ArrowDown</kbd></dt>
          <dd>Switch command results or terminal history</dd>
        </div>
      </dl>
    </section>
  </div>
</AppWindow>
