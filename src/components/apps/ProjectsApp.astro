---
import AppWindow from "../os/AppWindow.astro";
import ProjectCard from "../common/ProjectCard.astro";
import Badge from "../common/Badge.astro";
import EmptyState from "../common/EmptyState.astro";
import { postCategories, posts } from "../../data/posts";
import { projectCategories, projects, projectStatuses } from "../../data/projects";
import { withBase } from "../../data/site";

const initialProject = projects[0];
const postsBySlug = new Map(posts.map((post) => [post.slug, post]));
const initialRelatedPosts = initialProject.relatedPostSlugs
  .map((slug) => postsBySlug.get(slug))
  .filter(Boolean);
const serializedPosts = posts.map((post) => ({
  slug: post.slug,
  title: post.title,
  category: post.category,
  date: post.date
}));
---

<AppWindow title="Projects.app" subtitle="Open-source project matrix" wide detailControls>
  <div class="toolbar toolbar-stacked">
    <label class="search-field">
      <span>Search</span>
      <input type="search" data-project-search-input placeholder="Search projects, tags, or features" autocomplete="off" />
    </label>

      <div class="filter-stack">
      <div class="filter-group" aria-label="Project category filters">
        <button type="button" class="filter-button is-active" data-project-category-filter="all">All</button>
        {
          projectCategories.map((category) => (
            <button type="button" class="filter-button" data-project-category-filter={category}>{category}</button>
          ))
        }
      </div>

      <div class="filter-group" aria-label="Project status filters">
        <button type="button" class="filter-button is-active" data-project-status-filter="all">All status</button>
        {
          projectStatuses.map((status) => (
            <button type="button" class="filter-button" data-project-status-filter={status}>{status}</button>
          ))
        }
      </div>
      <button type="button" class="button button-secondary" data-project-clear-filters>Clear Filters</button>
    </div>
  </div>

  <div class="master-detail project-matrix-layout" data-project-layout data-layout="idle">
    <section class="master-panel project-list-panel" aria-label="Project matrix">
      <div class="project-grid" data-project-grid>
        {projects.map((project, index) => <ProjectCard project={project} selected={index === 0} />)}
      </div>
      <EmptyState
        title="No matching files found"
        description="Try clearing filters or searching another project tag."
        data-project-empty
        hidden
      />
    </section>

    <aside class="detail-panel project-detail-panel" data-project-detail aria-live="polite">
      <div class="detail-actions">
        <button type="button" class="button button-secondary" data-project-close>Close detail</button>
        <button type="button" class="button button-secondary" data-project-expand>Expand list</button>
        <button type="button" class="detail-focus-toggle" data-detail-focus-toggle aria-label="Focus detail panel" aria-pressed="false">Focus</button>
      </div>
      <p class="eyebrow" data-project-detail-type>{initialProject.type}</p>
      <h3 data-project-detail-name>{initialProject.name}</h3>
      <p data-project-detail-summary>{initialProject.summary}</p>

      <div class="detail-stack">
        <span>
          Category:
          <strong data-project-detail-category>{initialProject.category}</strong>
        </span>
        <span>
          Status:
          <strong data-project-detail-status>{initialProject.status}</strong>
        </span>
        <span>
          Version:
          <strong data-project-detail-version>{initialProject.version}</strong>
        </span>
        <span>
          Repository:
          <strong data-project-detail-repo>{initialProject.githubUrl.replace("https://github.com/", "")}</strong>
        </span>
      </div>

      <section class="feature-panel">
        <h4>Core Features</h4>
        <ul data-project-detail-features>
          {initialProject.features.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <div class="badge-row" data-project-detail-tags>
        {initialProject.tags.map((tag) => <Badge label={tag} />)}
      </div>

      <div class="card-actions">
        <a class="button button-primary" data-project-detail-live href={initialProject.liveUrl} target="_blank" rel="noreferrer">
          Live Demo
        </a>
        <a class="button button-secondary" data-project-detail-github href={initialProject.githubUrl} target="_blank" rel="noreferrer">
          GitHub
        </a>
      </div>

      <section class="related-panel">
        <h4>Related Articles</h4>
        <div class="related-list" data-project-detail-posts>
          {
            initialRelatedPosts.map((post) => (
              post && (
                <a class="related-link" href={withBase(`blog/?post=${post.slug}`)} data-lab-open-post={post.slug}>
                  {post.title}
                  <span>{postCategories.includes(post.category) ? post.category : "Post"}</span>
                </a>
              )
            ))
          }
        </div>
      </section>

      <section class="roadmap-panel">
        <h4>Roadmap</h4>
        <ul data-project-detail-roadmap>
          {initialProject.roadmap.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </aside>
  </div>

  <script is:inline type="application/json" id="projects-data" set:html={JSON.stringify(projects)} />
  <script is:inline type="application/json" id="project-posts-data" set:html={JSON.stringify(serializedPosts)} />
  <span data-base-url={import.meta.env.BASE_URL} hidden></span>
</AppWindow>

<script>
  const initProjectsApp = () => {
  type ProjectRecord = {
    slug: string;
    name: string;
    type: string;
    category: string;
    summary: string;
    status: string;
    version: string;
    features: string[];
    tags: string[];
    liveUrl: string;
    githubUrl: string;
    relatedPostSlugs: string[];
    roadmap: string[];
  };

  type RelatedPostRecord = {
    slug: string;
    title: string;
    category: string;
    date: string;
  };

  const dataNode = document.getElementById("projects-data");
  const postDataNode = document.getElementById("project-posts-data");
  const projectData: ProjectRecord[] = dataNode?.textContent ? JSON.parse(dataNode.textContent) : [];
  const relatedPostData: RelatedPostRecord[] = postDataNode?.textContent ? JSON.parse(postDataNode.textContent) : [];
  const baseUrl = document.querySelector("[data-base-url]")?.getAttribute("data-base-url") || "/";
  const searchInput = document.querySelector("[data-project-search-input]");
  const categoryButtons = Array.from(document.querySelectorAll("[data-project-category-filter]"));
  const statusButtons = Array.from(document.querySelectorAll("[data-project-status-filter]"));
  const cards = Array.from(document.querySelectorAll("[data-project-card]"));
  const detail = document.querySelector("[data-project-detail]");
  const layout = document.querySelector("[data-project-layout]");
  const emptyState = document.querySelector("[data-project-empty]");
  if (!(layout instanceof HTMLElement) || layout.dataset.controllerReady === "true") return;
  layout.dataset.controllerReady = "true";
  let activeCategory = "all";
  let activeStatus = "all";
  let activeSlug = new URLSearchParams(window.location.search).get("project") || projectData[0]?.slug || "";

  const withBasePath = (path: string) => {
    const normalizedBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
    return `${normalizedBase}${path.replace(/^\/+/, "")}`;
  };

  const setText = (selector: string, value: string) => {
    const node = detail?.querySelector(selector);
    if (node) node.textContent = value;
  };

  const createBadge = (label: string) => {
    const badge = document.createElement("span");
    badge.className = "badge badge-default";
    badge.textContent = label;
    return badge;
  };

  const renderList = (selector: string, values: string[]) => {
    const list = detail?.querySelector(selector);
    if (!list) return;
    list.textContent = "";
    values.forEach((value) => {
      const li = document.createElement("li");
      li.textContent = value;
      list.append(li);
    });
  };

  const renderRelatedPosts = (project: ProjectRecord) => {
    const wrap = detail?.querySelector("[data-project-detail-posts]");
    if (!wrap) return;
    wrap.textContent = "";
    project.relatedPostSlugs
      .map((slug) => relatedPostData.find((post) => post.slug === slug))
      .filter((post): post is RelatedPostRecord => Boolean(post))
      .forEach((post) => {
        const link = document.createElement("a");
        link.className = "related-link";
        link.href = withBasePath(`blog/?post=${post.slug}`);
        link.dataset.labOpenPost = post.slug;
        link.textContent = post.title;

        const meta = document.createElement("span");
        meta.textContent = post.category;
        link.append(meta);
        wrap.append(link);
      });
  };

  const setLayout = (value: "idle" | "focused" | "expanded") => {
    if (layout instanceof HTMLElement) layout.dataset.layout = value;
    window.labOS?.setState({ layoutState: value });
    document.querySelectorAll("[data-project-expand]").forEach((node) => {
      if (node instanceof HTMLButtonElement) {
        node.textContent = value === "expanded" ? "Focus detail" : "Expand list";
      }
    });
  };

  const selectProject = (slug: string, shouldFocus = true) => {
    const project = projectData.find((item) => item.slug === slug) || projectData[0];
    if (!project) return;
    activeSlug = project.slug;
    cards.forEach((card) => card.setAttribute("data-selected", card.getAttribute("data-project-slug") === activeSlug ? "true" : "false"));
    setText("[data-project-detail-type]", project.type);
    setText("[data-project-detail-name]", project.name);
    setText("[data-project-detail-summary]", project.summary);
    setText("[data-project-detail-category]", project.category);
    setText("[data-project-detail-status]", project.status);
    setText("[data-project-detail-version]", project.version);
    setText("[data-project-detail-repo]", project.githubUrl.replace("https://github.com/", ""));

    renderList("[data-project-detail-features]", project.features);
    renderList("[data-project-detail-roadmap]", project.roadmap);
    renderRelatedPosts(project);

    const live = detail?.querySelector("[data-project-detail-live]");
    const github = detail?.querySelector("[data-project-detail-github]");
    if (live instanceof HTMLAnchorElement) live.href = project.liveUrl;
    if (github instanceof HTMLAnchorElement) github.href = project.githubUrl;

    const tagWrap = detail?.querySelector("[data-project-detail-tags]");
    if (tagWrap) {
      tagWrap.textContent = "";
      project.tags.forEach((tag) => tagWrap.append(createBadge(tag)));
    }
    if (shouldFocus) {
      setLayout("focused");
      requestAnimationFrame(() => {
        if (detail instanceof HTMLElement) {
          const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const experience = document.documentElement.dataset.experience;
          const behavior = prefersReduced || experience === "performance" ? "instant" : "smooth";
          detail.scrollIntoView({ behavior, block: "nearest" });
        }
      });
    }
  };

  const applyProjectFilters = () => {
    const query = searchInput instanceof HTMLInputElement ? searchInput.value.trim().toLowerCase() : "";
    let firstVisible = "";
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesCategory = activeCategory === "all" || card.getAttribute("data-project-category") === activeCategory;
      const matchesStatus = activeStatus === "all" || card.getAttribute("data-project-status") === activeStatus;
      const matchesSearch = (card.getAttribute("data-project-search") || "").includes(query);
      const visible = matchesCategory && matchesStatus && matchesSearch;
      (card as HTMLElement).hidden = !visible;
      if (visible) {
        visibleCount += 1;
        if (!firstVisible) firstVisible = card.getAttribute("data-project-slug") || "";
      }
    });

    if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount > 0;

    const selectedCard = cards.find((card) => card.getAttribute("data-project-slug") === activeSlug);
    if ((!selectedCard || (selectedCard as HTMLElement).hidden) && firstVisible) {
      selectProject(firstVisible, layout instanceof HTMLElement && layout.dataset.layout !== "idle");
    }
  };

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.getAttribute("data-project-category-filter") || "all";
      categoryButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyProjectFilters();
    });
  });

  statusButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeStatus = button.getAttribute("data-project-status-filter") || "all";
      statusButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyProjectFilters();
    });
  });

  if (searchInput instanceof HTMLInputElement) {
    searchInput.addEventListener("input", applyProjectFilters);
  }

  cards.forEach((card) => {
    card.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) return;
      const slug = card.getAttribute("data-project-slug") || "";
      selectProject(slug);
      window.labOS?.openProject(slug, { navigate: false });
    });
    card.addEventListener("keydown", (event) => {
      if (event instanceof KeyboardEvent && (event.key === "Enter" || event.key === " ")) {
        event.preventDefault();
        const slug = card.getAttribute("data-project-slug") || "";
        selectProject(slug);
        window.labOS?.openProject(slug, { navigate: false });
      }
    });
  });

  document.addEventListener("labos:project-open", (event) => {
    if (!(event instanceof CustomEvent)) return;
    const slug = event.detail?.projectSlug;
    if (typeof slug === "string") selectProject(slug, true);
  });

  const closeButton = document.querySelector("[data-project-close]");
  if (closeButton instanceof HTMLButtonElement) {
    closeButton.addEventListener("click", () => setLayout("idle"));
  }

  const expandButton = document.querySelector("[data-project-expand]");
  if (expandButton instanceof HTMLButtonElement) {
    expandButton.addEventListener("click", () => {
      const current = layout instanceof HTMLElement ? layout.dataset.layout : "idle";
      setLayout(current === "expanded" ? "focused" : "expanded");
    });
  }

  const clearButton = document.querySelector("[data-project-clear-filters]");
  if (clearButton instanceof HTMLButtonElement) {
    clearButton.addEventListener("click", () => {
      activeCategory = "all";
      activeStatus = "all";
      if (searchInput instanceof HTMLInputElement) searchInput.value = "";
      categoryButtons.forEach((item) => item.classList.toggle("is-active", item.getAttribute("data-project-category-filter") === "all"));
      statusButtons.forEach((item) => item.classList.toggle("is-active", item.getAttribute("data-project-status-filter") === "all"));
      applyProjectFilters();
    });
  }

  selectProject(activeSlug, new URLSearchParams(window.location.search).has("project"));
  applyProjectFilters();
  };

  initProjectsApp();
  document.addEventListener("astro:page-load", initProjectsApp);
</script>
