---
import AppWindow from "../os/AppWindow.astro";
import Badge from "../common/Badge.astro";
import { timeline, timelineTypes } from "../../data/timeline";
import { projects } from "../../data/projects";

const initialEntry = timeline[0];
const initialProject = projects.find(
  (project) =>
    project.slug.toLowerCase() === initialEntry.relatedProject.toLowerCase() ||
    project.name.toLowerCase() === initialEntry.relatedProject.toLowerCase()
);
---

<AppWindow title="Timeline.app" subtitle="System Log" wide detailControls>
  <div class="toolbar toolbar-compact">
    <div class="filter-group" aria-label="Timeline type filters">
      <button type="button" class="filter-button is-active" data-log-filter="all">All</button>
      {timelineTypes.map((type) => <button type="button" class="filter-button" data-log-filter={type}>{type}</button>)}
    </div>
  </div>

  <div class="master-detail timeline-workbench" data-log-layout data-layout="idle">
    <section class="master-panel timeline-list" data-log-list aria-label="Timeline entries">
      {
        timeline.map((entry, index) => (
          <article
            class="timeline-entry interactive-card"
            data-log-card
            data-log-id={entry.id}
            data-log-type={entry.type}
            data-selected={index === 0 ? "true" : "false"}
            tabindex="0"
          >
            <div>
              <p class="eyebrow">{entry.type} / {entry.date}</p>
              <h3>{entry.title}</h3>
              <p>{entry.description}</p>
            </div>
            <Badge label={entry.relatedProject} />
          </article>
        ))
      }
    </section>

    <aside class="detail-panel timeline-detail-panel" data-log-detail aria-live="polite">
      <div class="detail-actions">
        <button type="button" class="button button-secondary" data-log-close>Close detail</button>
        <button type="button" class="button button-secondary" data-log-expand>Expand list</button>
      </div>
      <p class="eyebrow" data-log-detail-type>{initialEntry.type}</p>
      <h3 data-log-detail-title>{initialEntry.title}</h3>
      <p data-log-detail-description>{initialEntry.description}</p>
      <div class="detail-stack">
        <span>
          Date:
          <strong data-log-detail-date>{initialEntry.date}</strong>
        </span>
        <span>
          Related project:
          <strong data-log-detail-project>{initialEntry.relatedProject}</strong>
        </span>
      </div>
      <section class="related-panel">
        <h4>Related Project</h4>
        <div class="related-list" data-log-related-project>
          {
            initialProject ? (
              <button type="button" class="related-link" data-lab-open-project={initialProject.slug}>
                {initialProject.name}
                <span>{initialProject.type}</span>
              </button>
            ) : (
              <p class="empty-state">No related project matched in the local project matrix.</p>
            )
          }
        </div>
      </section>
    </aside>
  </div>

  <script is:inline type="application/json" id="timeline-data" set:html={JSON.stringify(timeline)} />
  <script is:inline type="application/json" id="timeline-projects-data" set:html={JSON.stringify(projects)} />
</AppWindow>

<script>
  type LogRecord = {
    id: string;
    date: string;
    type: string;
    title: string;
    description: string;
    relatedProject: string;
  };

  type ProjectRecord = {
    slug: string;
    name: string;
    type: string;
  };

  const dataNode = document.getElementById("timeline-data");
  const projectDataNode = document.getElementById("timeline-projects-data");
  const logData: LogRecord[] = dataNode?.textContent ? JSON.parse(dataNode.textContent) : [];
  const projectData: ProjectRecord[] = projectDataNode?.textContent ? JSON.parse(projectDataNode.textContent) : [];
  const filterButtons = Array.from(document.querySelectorAll("[data-log-filter]"));
  const cards = Array.from(document.querySelectorAll("[data-log-card]"));
  const detail = document.querySelector("[data-log-detail]");
  const layout = document.querySelector("[data-log-layout]");
  let activeFilter = "all";
  let activeId = new URLSearchParams(window.location.search).get("entry") || logData[0]?.id || "";

  const setText = (selector: string, value: string) => {
    const node = detail?.querySelector(selector);
    if (node) node.textContent = value;
  };

  const setLayout = (value: "idle" | "focused" | "expanded") => {
    if (layout instanceof HTMLElement) layout.dataset.layout = value;
    window.labOS?.setState({ layoutState: value });
    document.querySelectorAll("[data-log-expand]").forEach((node) => {
      if (node instanceof HTMLButtonElement) {
        node.textContent = value === "expanded" ? "Focus detail" : "Expand list";
      }
    });
  };

  const renderRelatedProject = (entry: LogRecord) => {
    const wrap = detail?.querySelector("[data-log-related-project]");
    if (!wrap) return;
    wrap.textContent = "";
    const related = entry.relatedProject.toLowerCase();
    const project = projectData.find((item) => item.slug.toLowerCase() === related || item.name.toLowerCase() === related);
    if (!project) {
      const empty = document.createElement("p");
      empty.className = "empty-state";
      empty.textContent = "No related project matched in the local project matrix.";
      wrap.append(empty);
      return;
    }

    const button = document.createElement("button");
    button.type = "button";
    button.className = "related-link";
    button.dataset.labOpenProject = project.slug;
    button.textContent = project.name;
    const meta = document.createElement("span");
    meta.textContent = project.type;
    button.append(meta);
    wrap.append(button);
  };

  const selectLog = (id: string, shouldFocus = true) => {
    const entry = logData.find((item) => item.id === id) || logData[0];
    if (!entry) return;
    activeId = entry.id;
    cards.forEach((card) => card.setAttribute("data-selected", card.getAttribute("data-log-id") === activeId ? "true" : "false"));
    setText("[data-log-detail-type]", entry.type);
    setText("[data-log-detail-title]", entry.title);
    setText("[data-log-detail-description]", entry.description);
    setText("[data-log-detail-date]", entry.date);
    setText("[data-log-detail-project]", entry.relatedProject);
    renderRelatedProject(entry);
    if (shouldFocus) setLayout("focused");
  };

  const applyLogFilters = () => {
    let firstVisible = "";
    cards.forEach((card) => {
      const visible = activeFilter === "all" || card.getAttribute("data-log-type") === activeFilter;
      (card as HTMLElement).hidden = !visible;
      if (visible && !firstVisible) firstVisible = card.getAttribute("data-log-id") || "";
    });
    const selectedCard = cards.find((card) => card.getAttribute("data-log-id") === activeId);
    if (!selectedCard || (selectedCard as HTMLElement).hidden) {
      selectLog(firstVisible, layout instanceof HTMLElement && layout.dataset.layout !== "idle");
    }
  };

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeFilter = button.getAttribute("data-log-filter") || "all";
      filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyLogFilters();
    });
  });

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.getAttribute("data-log-id") || "";
      selectLog(id);
      window.labOS?.openTimeline(id, { navigate: false });
    });
    card.addEventListener("keydown", (event) => {
      if (event instanceof KeyboardEvent && (event.key === "Enter" || event.key === " ")) {
        event.preventDefault();
        const id = card.getAttribute("data-log-id") || "";
        selectLog(id);
        window.labOS?.openTimeline(id, { navigate: false });
      }
    });
  });

  document.addEventListener("labos:timeline-open", (event) => {
    if (!(event instanceof CustomEvent)) return;
    const id = event.detail?.timelineId;
    if (typeof id === "string") selectLog(id, true);
  });

  const closeButton = document.querySelector("[data-log-close]");
  if (closeButton instanceof HTMLButtonElement) {
    closeButton.addEventListener("click", () => setLayout("idle"));
  }

  const expandButton = document.querySelector("[data-log-expand]");
  if (expandButton instanceof HTMLButtonElement) {
    expandButton.addEventListener("click", () => {
      const current = layout instanceof HTMLElement ? layout.dataset.layout : "idle";
      setLayout(current === "expanded" ? "focused" : "expanded");
    });
  }

  selectLog(activeId, new URLSearchParams(window.location.search).has("entry"));
  applyLogFilters();
</script>
