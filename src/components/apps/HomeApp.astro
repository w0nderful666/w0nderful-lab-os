---
import AppWindow from "../os/AppWindow.astro";
import DesktopWidget from "../os/DesktopWidget.astro";
import ExperienceModeControl from "../os/ExperienceModeControl.astro";
import Badge from "../common/Badge.astro";
import { posts } from "../../data/posts";
import { projects } from "../../data/projects";
import { site, withBase } from "../../data/site";
import { timeline } from "../../data/timeline";

const featuredProjects = projects.filter((project) => project.featured).slice(0, 4);
const latestPosts = posts.slice(0, 3);
const latestLogs = timeline.slice(0, 3);

const desktopShortcuts = [
  { id: "projects", label: "Projects.app", href: withBase("projects/"), icon: "P", status: `${projects.length} projects` },
  { id: "blog", label: "Blog.app", href: withBase("blog/"), icon: "B", status: `${posts.length} posts` },
  { id: "timeline", label: "Timeline.app", href: withBase("timeline/"), icon: "L", status: `${timeline.length} entries` },
  { id: "settings", label: "Settings.app", href: withBase("settings/"), icon: "S", status: "System prefs" },
  { id: "about", label: "About.app", href: withBase("about/"), icon: "A", status: "System info" }
];
---

<div class="desktop-workspace">
  <section class="desktop-shortcuts" aria-label="Desktop application shortcuts">
    <p class="eyebrow desktop-stagger" style="--stagger-index: 0">Desktop</p>
    <div class="shortcut-grid">
      {
        desktopShortcuts.map((shortcut) => (
          <a
            href={shortcut.href}
            class="desktop-shortcut desktop-stagger"
            style={`--stagger-index: ${desktopShortcuts.indexOf(shortcut) + 1}`}
            data-app-link={shortcut.id}
          >
            <span class="shortcut-icon" aria-hidden="true">{shortcut.icon}</span>
            <span class="shortcut-label">{shortcut.label}</span>
            <span class="shortcut-status">{shortcut.status}</span>
          </a>
        ))
      }
    </div>
  </section>

  <AppWindow title="Home.app" subtitle="Desktop Workspace" wide>
    <div class="dashboard-grid">
      <section class="hero-console desktop-stagger" style="--stagger-index: 1" aria-label="Welcome Terminal">
        <div class="terminal-topline">
          <span>Welcome Terminal</span>
          <span>zsh</span>
        </div>
        <pre><code>$ whoami
w0nderful666
$ lab status
A-Level Open Source Lab
Local First / No Backend / GitHub Pages Ready</code></pre>
      </section>

      <section class="status-panel">
        <p class="eyebrow">Personal Open Source Lab</p>
        <h1>{site.name}</h1>
        <p>{site.description}</p>
        <div class="stat-grid">
          <div>
            <strong>{projects.length}</strong>
            <span>Projects</span>
          </div>
          <div>
            <strong>{posts.length}</strong>
            <span>Posts</span>
          </div>
          <div>
            <strong>{timeline[0].date}</strong>
            <span>Latest Update</span>
          </div>
        </div>
        <div class="badge-row">
          {site.brandTags.map((tag) => <Badge label={tag} />)}
        </div>
      </section>
    </div>
  </AppWindow>

  <div class="widget-grid">
    <DesktopWidget title="Featured Projects" meta="Pinned apps" stagger={2}>
      <div class="compact-list">
        {
          featuredProjects.map((project) => (
            <a class="compact-row" href={withBase(`projects/?project=${project.slug}`)} data-lab-open-project={project.slug}>
              <span>{project.name}</span>
              <small>{project.type}</small>
            </a>
          ))
        }
      </div>
    </DesktopWidget>

    <DesktopWidget title="Latest Posts" meta="Docs" stagger={3}>
      <div class="compact-list">
        {
          latestPosts.map((post) => (
            <a class="compact-row" href={withBase(`blog/?post=${post.slug}`)} data-lab-open-post={post.slug}>
              <span>{post.title}</span>
              <small>{post.readingTime}</small>
            </a>
          ))
        }
      </div>
    </DesktopWidget>

    <DesktopWidget title="System Update Log" meta="Recent" stagger={4}>
      <div class="compact-list">
        {
          latestLogs.map((entry) => (
            <a class="compact-row" href={withBase(`timeline/?entry=${entry.id}`)} data-lab-open-timeline={entry.id}>
              <span>{entry.title}</span>
              <small>{entry.type} / {entry.date}</small>
            </a>
          ))
        }
      </div>
    </DesktopWidget>

    <DesktopWidget title="Recent Activity" meta="System State" stagger={5}>
      <div class="compact-list recent-list" data-recent-items-list></div>
    </DesktopWidget>

    <DesktopWidget title="Quick Actions" meta="Launch" stagger={6}>
      <div class="quick-actions">
        <button type="button" class="button button-primary" data-command-palette-open>Command Palette</button>
        <a class="button button-primary" href={withBase("projects/")}>Open Projects</a>
        <a class="button button-secondary" href={withBase("blog/")}>Read Blog</a>
        <a class="button button-secondary" href={withBase("timeline/")}>View Timeline</a>
        <a class="button button-secondary" href={withBase("terminal/")}>Open Terminal</a>
        <a class="button button-secondary" href={site.repositoryUrl} target="_blank" rel="noreferrer">
          Open GitHub
        </a>
      </div>
    </DesktopWidget>

    <DesktopWidget title="Experience Mode" meta="Desktop profile" stagger={7}>
      <ExperienceModeControl />
    </DesktopWidget>
  </div>
</div>
