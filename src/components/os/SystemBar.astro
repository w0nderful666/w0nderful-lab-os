---
import { site } from "../../data/site";
import { topNavigation, type ActiveApp } from "../../data/navigation";
import { withBase } from "../../data/site";

type Props = {
  active: ActiveApp;
};

const { active } = Astro.props;
const appLabels: Record<string, string> = {
  home: "Home",
  projects: "Projects",
  blog: "Blog",
  timeline: "Timeline",
  about: "About",
  settings: "Settings",
  terminal: "Terminal"
};
---

<header class="system-bar" transition:name="lab-system-bar" transition:persist>
  <div class="system-bar-left">
    <a class="system-brand" href={topNavigation[0].href}>{site.name}</a>
    <nav class="system-nav" aria-label="Primary">
      {
        topNavigation.map((item) => (
          <a
            href={item.href}
            class:list={["system-nav-link", active === item.id && "is-active"]}
            data-app-link={item.id}
            data-i18n={item.i18nKey}
            aria-current={active === item.id ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="system-bar-right">
    <button type="button" class="system-command-button" data-command-palette-open aria-label="Open Command Palette">
      Command
    </button>
    <a href={site.repositoryUrl} target="_blank" rel="noreferrer">GitHub</a>
    <span class="system-bar-status" data-system-app-label>{appLabels[active] || "Home"}</span>
    <span class="system-bar-status" data-system-palette-label>Aurora</span>
    <span class="system-bar-status" data-system-background-label>Aurora Mist</span>
    <a class="system-bar-version" href={withBase("settings/")} data-app-link="settings" title="Open Settings">{site.displayVersion}</a>
    <span class="system-bar-compact">Local First</span>
    <time data-system-time datetime="">--:--</time>
  </div>
</header>

<script>
  const timeNode = document.querySelector("[data-system-time]");
  const updateSystemTime = () => {
    if (!(timeNode instanceof HTMLTimeElement)) return;
    const now = new Date();
    timeNode.textContent = new Intl.DateTimeFormat(undefined, {
      hour: "2-digit",
      minute: "2-digit"
    }).format(now);
    timeNode.dateTime = now.toISOString();
  };

  updateSystemTime();
  window.setInterval(updateSystemTime, 30000);
</script>
