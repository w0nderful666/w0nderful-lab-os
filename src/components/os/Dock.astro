---
import { dockNavigation, type ActiveApp } from "../../data/navigation";

type Props = {
  active: ActiveApp;
};

const { active } = Astro.props;

const dockInitials: Record<string, string> = {
  home: "H",
  projects: "P",
  blog: "B",
  timeline: "L",
  about: "A",
  settings: "S",
  terminal: "$"
};
---

<nav class="dock" aria-label="Dock" transition:name="lab-dock" transition:persist>
  {
    dockNavigation.map((item) => (
      <a
        href={item.href}
        class:list={["dock-item", active === item.id && "is-active"]}
        data-app-link={item.id}
        aria-current={active === item.id ? "page" : undefined}
      >
        <span class="dock-icon" aria-hidden="true">{dockInitials[item.id]}</span>
        <span class="dock-label" data-i18n={item.i18nKey}>{item.label}</span>
      </a>
    ))
  }
</nav>
