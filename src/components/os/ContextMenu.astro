---
---

<div class="context-menu" data-context-menu hidden>
  <div class="context-menu-inner" data-context-menu-list></div>
</div>

<script>
  type MenuItem = {
    label: string;
    shortcut?: string;
    action: () => void;
    divider?: boolean;
  };

  let open = false;

  const getItems = (target: Element): MenuItem[] => {
    const projectCard = target.closest("[data-lab-open-project]");
    const postCard = target.closest("[data-lab-open-post]");
    const link = target.closest("a[data-app-link]");

    if (projectCard instanceof HTMLElement) {
      const slug = projectCard.dataset.labOpenProject || "";
      const href = projectCard.closest("a")?.href || "";
      return [
        { label: "Open Project", action: () => window.labOS.openProject(slug) },
        { label: "Open in New Tab", action: () => window.open(href, "_blank") },
        { label: "Copy Link", shortcut: "⌘C", action: () => { try { navigator.clipboard.writeText(href); } catch {} } },
      ];
    }

    if (postCard instanceof HTMLElement) {
      const slug = postCard.dataset.labOpenPost || "";
      const href = postCard.closest("a")?.href || "";
      return [
        { label: "Read Article", action: () => window.labOS.openPost(slug) },
        { label: "Open in New Tab", action: () => window.open(href, "_blank") },
        { label: "Copy Link", shortcut: "⌘C", action: () => { try { navigator.clipboard.writeText(href); } catch {} } },
      ];
    }

    if (link instanceof HTMLElement) {
      const app = link.dataset.appLink || "";
      return [
        { label: `Open ${app}`, action: () => window.labOS.openApp(app as Parameters<typeof window.labOS.openApp>[0]) },
        { label: "Open in New Tab", action: () => window.open((link as HTMLAnchorElement).href, "_blank") },
      ];
    }

    return [
      { label: "Command Palette", shortcut: "⌘K", action: () => document.dispatchEvent(new CustomEvent("labos:open-command-palette")) },
      { label: "Go Home", action: () => window.labOS.openApp("home") },
      { label: "Terminal", shortcut: "G+T", action: () => window.labOS.openApp("terminal") },
      { divider: true, label: "Toggle Theme", action: () => window.labOS.setState({ theme: document.documentElement.dataset.theme === "dark" ? "light" : "dark" }) },
    ];
  };

  const renderMenu = (items: MenuItem[]) => {
    const list = document.querySelector("[data-context-menu-list]");
    if (!list) return;
    list.innerHTML = "";
    for (const item of items) {
      if (item.divider) {
        const d = document.createElement("div");
        d.className = "context-divider";
        list.append(d);
        continue;
      }
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "context-item";
      btn.innerHTML = `<span class="ctx-label">${item.label}</span>${item.shortcut ? `<span class="ctx-key">${item.shortcut}</span>` : ""}`;
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        closeMenu();
        item.action();
      }, { once: true });
      list.append(btn);
    }
  };

  const openMenu = (x: number, y: number, target: Element) => {
    const menu = document.querySelector("[data-context-menu]");
    if (!menu) return;
    renderMenu(getItems(target));
    menu.removeAttribute("hidden");
    open = true;
    const el = menu as HTMLElement;
    requestAnimationFrame(() => {
      const r = menu.getBoundingClientRect();
      el.style.left = Math.min(x, window.innerWidth - r.width - 8) + "px";
      el.style.top = Math.min(y, window.innerHeight - r.height - 8) + "px";
    });
  };

  const closeMenu = () => {
    const menu = document.querySelector("[data-context-menu]");
    if (!menu) return;
    menu.setAttribute("hidden", "");
    open = false;
  };

  document.addEventListener("contextmenu", (e) => {
    if (!(e.target instanceof Element)) return;
    e.preventDefault();
    openMenu(e.clientX, e.clientY, e.target);
  }, true);

  document.addEventListener("click", (e) => {
    if (open && !(e.target as Element)?.closest("[data-context-menu]")) closeMenu();
  }, true);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && open) closeMenu();
  });
</script>

<style>
  .context-menu {
    position: fixed;
    z-index: 9999;
    min-width: 190px;
    padding: 4px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-panel);
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow);
    animation: ctx-in 0.1s ease;
  }

  .context-menu[hidden] { display: none; }

  .context-menu-inner {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .context-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 6px 10px;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 0.08s;
    text-align: left;
    width: 100%;
  }

  .context-item:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .ctx-label { font-weight: 500; }
  .ctx-key { color: var(--text-muted); font-size: 0.7rem; font-family: var(--font-mono); }

  .context-divider {
    height: 1px;
    margin: 3px 4px;
    background: var(--border);
  }

  @keyframes ctx-in {
    from { opacity: 0; transform: scale(0.97) translateY(-3px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>
