<div class="command-palette-shell" data-command-palette hidden>
  <button
    type="button"
    class="command-palette-overlay"
    data-command-palette-close
    aria-label="Close Command Palette"
  >
    <span class="sr-only">Close Command Palette</span>
  </button>
  <section class="command-palette-panel" role="dialog" aria-modal="true" aria-labelledby="command-palette-title">
    <header class="command-palette-header">
      <div>
        <p class="eyebrow">Control Layer</p>
        <h2 id="command-palette-title">Command Palette</h2>
      </div>
      <span data-command-status>Recent Items and commands</span>
    </header>

    <label class="command-input-shell">
      <span aria-hidden="true">&gt;</span>
      <input
        type="search"
        data-command-input
        autocomplete="off"
        spellcheck="false"
        placeholder="Search apps, projects, posts, timeline, commands"
      />
    </label>

    <div class="command-results" data-command-results role="listbox" aria-label="Command results"></div>

    <footer class="command-palette-footer">
      <span><kbd>Ctrl</kbd>/<kbd>Cmd</kbd> + <kbd>K</kbd></span>
      <span><kbd>Enter</kbd> execute</span>
      <span><kbd>Esc</kbd> close</span>
    </footer>
  </section>
</div>
