---
---

<div class="boot-screen" data-boot-screen>
  <div class="boot-content">
    <div class="boot-logo">
      <span class="boot-sigil">&lt;/&gt;</span>
    </div>
    <div class="boot-lines">
      <div class="boot-line" data-boot-line="0">System check ... <span class="boot-ok">OK</span></div>
      <div class="boot-line" data-boot-line="1">Loading modules ... <span class="boot-ok">OK</span></div>
      <div class="boot-line" data-boot-line="2">Initializing workspace ...</div>
    </div>
    <div class="boot-progress">
      <div class="boot-progress-bar" data-boot-progress></div>
    </div>
  </div>
</div>

<script>
  const initBoot = () => {
    const screen = document.querySelector("[data-boot-screen]");
    if (!(screen instanceof HTMLElement)) return;
    if (screen.dataset.bootDone === "true") return;

    try {
      if (sessionStorage.getItem("lab-os-booted") === "true") {
        screen.remove();
        return;
      }
    } catch {}

    screen.dataset.bootDone = "true";
    const lines = screen.querySelectorAll("[data-boot-line]");
    const progress = screen.querySelector("[data-boot-progress]");

    lines.forEach((line, i) => {
      (line as HTMLElement).style.animationDelay = `${i * 300}ms`;
    });

    setTimeout(() => {
      if (progress instanceof HTMLElement) {
        progress.style.width = "100%";
      }
    }, 200);

    setTimeout(() => {
      screen.classList.add("boot-exit");
      try { sessionStorage.setItem("lab-os-booted", "true"); } catch {}
      setTimeout(() => screen.remove(), 500);
    }, 1400);
  };

  initBoot();
  document.addEventListener("astro:after-swap", initBoot);
</script>

<style>
  .boot-screen {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .boot-exit {
    opacity: 0;
    transform: scale(1.01);
    pointer-events: none;
  }

  .boot-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 280px;
  }

  .boot-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 2px solid var(--border-strong);
    border-radius: 14px;
    animation: boot-pulse 1.2s ease-in-out infinite;
  }

  .boot-sigil {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
  }

  .boot-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .boot-line {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    opacity: 0;
    animation: boot-line-in 0.3s ease forwards;
    letter-spacing: 0.02em;
  }

  .boot-ok {
    color: var(--success);
    font-weight: 600;
  }

  .boot-progress {
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--border);
    overflow: hidden;
  }

  .boot-progress-bar {
    width: 0;
    height: 100%;
    background: var(--accent);
    border-radius: 1px;
    transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes boot-line-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes boot-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-screen { display: none; }
  }
</style>
