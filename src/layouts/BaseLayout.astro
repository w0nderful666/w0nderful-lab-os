---
import SystemBar from "../components/os/SystemBar.astro";
import Dock from "../components/os/Dock.astro";
import CommandPalette from "../components/os/CommandPalette.astro";
import WelcomeToast from "../components/os/WelcomeToast.astro";
import { ClientRouter } from "astro:transitions";
import { site } from "../data/site";
import type { ActiveApp } from "../data/navigation";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/motion.css";
import "../styles/os-theme.css";

type Props = {
  active?: ActiveApp;
  title?: string;
  description?: string;
};

const {
  active = "home",
  title = site.title,
  description = site.description
} = Astro.props;
const pageTitle = title === site.title ? site.title : `${title} | ${site.name}`;
---

<!doctype html>
<html
  lang="en"
  data-theme="dark"
  data-theme-setting="system"
  data-experience="balanced"
  data-motion-speed="normal"
  data-palette="aurora"
  data-background="aurora"
  data-current-app={active}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101416" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.liveUrl} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        const key = "w0nderful-lab-os.settings";
        const defaults = {
          theme: "system",
          experience: "balanced",
          experienceMode: "balanced",
          language: "en",
          motionSpeed: "normal",
          palette: "aurora",
          background: "aurora"
        };
        let settings = defaults;
        try {
          settings = { ...defaults, ...JSON.parse(localStorage.getItem(key) || "{}") };
        } catch {
          settings = defaults;
        }
        const experience = settings.experienceMode || settings.experience || "balanced";
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = settings.theme === "system" ? (systemDark ? "dark" : "light") : settings.theme;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeSetting = settings.theme;
        document.documentElement.dataset.experience = experience;
        document.documentElement.dataset.motionSpeed = settings.motionSpeed || "normal";
        document.documentElement.dataset.palette = settings.palette || "aurora";
        document.documentElement.dataset.background = settings.background || "aurora";
        document.documentElement.lang = settings.language === "zh" ? "zh-CN" : "en";
      })();
    </script>
  </head>
  <body
    data-current-app={active}
    data-experience="balanced"
    data-motion-speed="normal"
    data-palette="aurora"
    data-background="aurora"
  >
    <SystemBar active={active} />
    <main class="desktop-shell" transition:name="lab-main" transition:animate="fade">
      <slot />
    </main>
    <Dock active={active} />
    <CommandPalette />
    <WelcomeToast />
    <footer class="site-footer" transition:name="lab-footer" transition:persist>
      <span>{site.name}</span>
      <span>{site.displayVersion}</span>
      <span>Local First</span>
      <span>No Backend</span>
      <span>GitHub Pages Ready</span>
      <span>
        Experience:
        <strong data-current-experience>Balanced</strong>
      </span>
      <span>
        Motion:
        <strong data-current-motion-speed>Normal</strong>
      </span>
      <span>
        Palette:
        <strong data-current-palette>Aurora</strong>
      </span>
    </footer>
    <script>
      import "../scripts/system-state";
      import "../scripts/command-palette";
      import "../scripts/shortcuts";
    </script>
  </body>
</html>
